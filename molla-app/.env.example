# Real connection server. Copy to .env and keep all keys on the server.
# Run scripts/enable-live.ps1 (Windows) or node scripts/enable-live.mjs first.
# The isolated recording demo uses server/demo.mjs and does not need these settings.
PORT=4318
MOLLA_HOST=127.0.0.1
MOLLA_WEB_ROOT=live/mobile
MOLLA_LIVE_MODE=1
MOLLA_LLM_ENABLED=0
# Provider selector: letsur or vercel. No automatic provider fallback.
MOLLA_LLM_PROVIDER=letsur
LETSUR_API_KEY=
LETSUR_BASE_URL=https://gw.letsur.ai/v1
LETSUR_MODEL=gpt-6.1-terra
# Terra: medium balances response speed and reasoning. No automatic model fallback.
LETSUR_REASONING_EFFORT=medium
AI_GATEWAY_API_KEY=
MOLLA_MODEL=openai/gpt-5-mini
MOLLA_LLM_DAILY_REQUEST_LIMIT=40
# Bound by the operator to one consenting owner, for a read-only phone diagnostic.
MOLLA_PHONE_OWNER=
MOLLA_PHONE_SERIAL=
MOLLA_PYTHON=python
# Optional per-owner cloud Android VM bindings, configured by the operator.
# Never bind one VM to multiple owners. Legacy OWNER/SERIAL above remain supported.
MOLLA_PHONE_BINDINGS={}
# Example: {"mom":{"serial":"127.0.0.1:5555","mode":"cloud"},"dad":{"serial":"127.0.0.1:5557","mode":"cloud"}}
# This opens only a message compose screen after owner approval. It never presses Send.
MOLLA_ALLOW_ANDROID_COMPOSE=0
MOLLA_ALLOW_ANDROID_APPS=0
MOLLA_VM_MAX_MINUTES=5
MOLLA_ADB=adb
