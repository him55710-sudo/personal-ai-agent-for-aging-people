{
  "expo": {
    "name": "Cheese",
    "slug": "molla-companion",
    "scheme": "molla",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "name": "Cheese — 우리 가족 AI",
      "favicon": "./assets/cheese.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ]
  }
}
