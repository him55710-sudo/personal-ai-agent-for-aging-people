# Explicit loopback development. Production: omit this and configure TLS below.
MOLLA_ENV=development
MOLLA_HOST=127.0.0.1
PORT=4319
MOLLA_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
MOLLA_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# MOLLA_TLS_CERT=/run/secrets/fullchain.pem
# MOLLA_TLS_KEY=/run/secrets/privkey.pem
# Alternatively an HTTPS proxy on this host, API bound ONLY to loopback:
# MOLLA_TRUST_LOOPBACK_PROXY=1
# MOLLA_API_DATA_DIR=/private/molla
# MOLLA_API_AUTH_FILE=/private/molla/owners.json
MOLLA_RATE_PER_MINUTE=120
MOLLA_LLM_ENABLED=1
MOLLA_LLM_PROVIDER=openai-compatible
MOLLA_LLM_BASE_URL=https://your-gateway.example/v1
MOLLA_LLM_MODEL=your-model-with-tools
MOLLA_LLM_API_KEY=
MOLLA_LLM_TIMEOUT_MS=40000
MOLLA_LLM_DAILY_REQUEST_LIMIT=40
# Letsur preset: PROVIDER=letsur, LETSUR_API_KEY, LETSUR_MODEL=gpt-4.1-mini
# Vercel preset: PROVIDER=vercel, AI_GATEWAY_API_KEY, MOLLA_MODEL=openai/gpt-5-mini
MOLLA_ALLOW_ANDROID_APPS=1
MOLLA_ALLOW_ANDROID_COMPOSE=1
MOLLA_ALLOW_ANDROID_UI=1
# Bounded Observe/Reason/Act/Verify tasks: opt in explicitly; no automatic VM start.
MOLLA_ALLOW_ANDROID_AGENT=0
MOLLA_VM_MAX_MINUTES=3
# No device is started automatically. Owner must accept a quote.
# MOLLA_CLOUD_BINDINGS={"mom":{"phoneId":"your-saved-profile"}}
# MOLLA_PHONE_HARNESS_PATH=/path/to/pinned/phone-harness
# PHONE_HARNESS_HOME=/private/phone-harness-login
# MOLLA_ADB=/path/to/platform-tools/adb
# Local pre-connected Android alternative (each serial belongs to only one owner):
# MOLLA_PHONE_BINDINGS={"mom":{"serial":"emulator-5554","mode":"local"}}
