# 기본 모드에서는 아래 설정을 모두 비워 둡니다.
# LLM API를 사용하려면 FA_MODEL과 키 또는 호환 API 주소를 설정합니다.
# API 주소를 생략하면 기본 주소 https://api.openai.com/v1 을 사용합니다.
# FA_MODEL=
# FA_API_KEY=
# FA_API_BASE_URL=http://127.0.0.1:11434/v1
# PORT=4173

# 실제 실행 패널 전용 owner API (서버 설정, loopback만 허용)
# MOLLA_OWNER_API_URL=http://127.0.0.1:4319
